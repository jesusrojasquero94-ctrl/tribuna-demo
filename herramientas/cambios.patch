+      '<div class="fila"><span class="estado" style="color:var(--mal)">' + ESTADOS.rechazado.i + '<span style="color:var(--tinta)">Rechazado</span></span><span class="num">' + usd(re) + '</span></div>' + extra + '</section>';
+  }).join('');
+}
+
+/* ---------- Tabla de cobros ---------- */
