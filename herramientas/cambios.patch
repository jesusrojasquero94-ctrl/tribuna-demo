+  $('filtroJuego').innerHTML = '<option value="">Todos los juegos</option>' + S.datos.juegos.slice().reverse().map(function(j){ return '<option value="' + j.id + '">' + (j.fecha > hoy() ? 'Próximo: ' : '') + 'vs ' + j.rival + ', ' + fechaLarga(j.fecha) + (j.clasico ? ' (clásico)' : '') + '</option>'; }).join('');
