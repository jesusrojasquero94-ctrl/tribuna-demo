+<!doctype html>
+<html lang="es-VE">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Portal del estadio | Tribuna</title>
+<meta name="description" content="Demo del portal de Tribuna para estadios: ventas, cobros por Pago Móvil, Zelle y USDT, conciliación y cortes en un solo lugar.">
+<meta name="robots" content="noindex">
+<meta name="theme-color" content="#070D1A">
+<meta name="color-scheme" content="dark">
+<link rel="icon" href="/favicon.ico" sizes="48x48">
+<link rel="icon" href="/icono.svg" type="image/svg+xml">
+<link rel="apple-touch-icon" href="/apple-touch-icon.png">
+<link rel="preload" as="font" type="font/woff2" href="/fuentes/titulo-800.woff2" crossorigin>
+<link rel="preload" as="font" type="font/woff2" href="/fuentes/texto-400.woff2" crossorigin>
+<style>
+@font-face{font-family:"Big Shoulders Display";font-weight:800;font-display:swap;src:url(/fuentes/titulo-800.woff2) format("woff2")}
+@font-face{font-family:"Hanken Grotesk";font-weight:400;font-display:swap;src:url(/fuentes/texto-400.woff2) format("woff2")}
+@font-face{font-family:"Hanken Grotesk";font-weight:500;font-display:swap;src:url(/fuentes/texto-500.woff2) format("woff2")}
+@font-face{font-family:"Hanken Grotesk";font-weight:700;font-display:swap;src:url(/fuentes/texto-700.woff2) format("woff2")}
+:root{
+  --noche:#070D1A; --superficie:#0A1222; --tarjeta:#0E1729; --borde:rgba(255,255,255,.12); --linea:rgba(255,255,255,.08);
+  --tinta:#F3F5F1; --suave:#B9C5DA; --tenue:#8492AC; --naranja:#FF8A1F;
+  --pm:#3987e5; --ze:#d95926; --us:#199e70;
+  --bien:#0ca30c; --aviso:#fab219; --mal:#d03b3b;
+  --titulo:"Big Shoulders Display","Arial Narrow",Impact,sans-serif;
+  --texto:"Hanken Grotesk",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
+}
+*{box-sizing:border-box}
+html{scrollbar-color:#33415E #070D1A}
+body{margin:0;background:var(--noche);color:var(--tinta);font-family:var(--texto);font-size:15px;line-height:1.45;-webkit-font-smoothing:antialiased}
+button,select,input{font:inherit;color:inherit}
+button{cursor:pointer}
+a{color:inherit;text-underline-offset:3px}
+:focus-visible{outline:3px solid var(--naranja);outline-offset:2px}
+[hidden]{display:none!important}
+.num{font-variant-numeric:tabular-nums}
+.marca{display:inline-flex;align-items:center;gap:9px;font-family:var(--titulo);font-weight:800;font-size:24px;line-height:1;text-decoration:none}
+.marca svg{width:34px;height:22px}
+.boton{border:0;border-radius:12px;padding:11px 16px;font-weight:700;background:var(--naranja);color:#0E1F3D;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;transition:background-color .15s ease,transform .15s cubic-bezier(.23,1,.32,1)}
+.boton:active{transform:scale(.97)}
+.boton.claro{background:rgba(255,255,255,.1);color:#fff}
+@media (hover:hover){.boton:hover{background:#FFA24D}.boton.claro:hover{background:rgba(255,255,255,.18)}}
+.boton.chico{min-height:34px;padding:6px 12px;font-size:14px;border-radius:9px}
+
+/* Acceso */
+.acceso{min-height:100svh;display:grid;place-items:center;padding:24px;background:radial-gradient(120% 80% at 50% 0,#13244A 0,var(--noche) 60%)}
+.caja{width:min(440px,100%);background:var(--superficie);border:1px solid var(--borde);border-radius:22px;padding:28px}
+.caja h1{font-family:var(--titulo);font-weight:800;font-size:44px;line-height:.95;margin:22px 0 8px}
+.caja p{color:var(--suave);margin:0 0 18px}
+.campo{display:grid;gap:6px;margin-bottom:16px}
+.campo label{font-weight:700;font-size:14px}
+select{background:var(--tarjeta);border:1px solid var(--borde);border-radius:10px;padding:10px 12px;min-height:44px;width:100%}
+.letra-chica{font-size:13px;color:var(--tenue);margin:16px 0 0!important}
+.caja .boton{width:100%}
+
+/* Panel */
+.barra{position:sticky;top:0;z-index:20;background:rgba(7,13,26,.92);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border-bottom:1px solid var(--borde)}
+.barra .dentro{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:12px 24px;max-width:1320px;margin:0 auto}
+.barra .estadio{font-weight:700}
+.barra .estadio small{display:block;font-weight:400;color:var(--suave);font-size:13px}
+.barra .der{margin-left:auto;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
+.aviso-demo{background:#04070F;color:#C9D4E8;font-size:13px;text-align:center;padding:7px 16px}
+.aviso-demo strong{color:var(--naranja)}
+main{max-width:1320px;margin:0 auto;padding:22px 24px 60px}
+.filtros{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:18px}
+.filtros select{width:auto;min-width:220px}
+.rango{display:inline-flex;background:var(--tarjeta);border:1px solid var(--borde);border-radius:10px;padding:3px}
+.rango button{background:none;border:0;border-radius:8px;padding:7px 12px;color:var(--suave);font-weight:500}
+.rango button[aria-pressed="true"]{background:rgba(255,255,255,.12);color:#fff;font-weight:700}
+.tiles{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:12px}
+.tile{background:var(--superficie);border:1px solid var(--borde);border-radius:16px;padding:16px}
+.tile .et{color:var(--suave);font-size:13px}
+.tile .val{font-family:var(--titulo);font-weight:800;font-size:38px;line-height:1;margin:8px 0 4px}
+.tile .det{color:var(--tenue);font-size:13px}
+.rejilla{display:grid;grid-template-columns:1.6fr 1fr;gap:12px;margin-bottom:12px}
+.tarjeta{background:var(--superficie);border:1px solid var(--borde);border-radius:16px;padding:18px;min-width:0}
+.tarjeta h2{font-size:17px;margin:0 0 2px}
+.tarjeta .sub{color:var(--suave);font-size:13px;margin:0 0 14px}
+.cab{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap}
+.leyenda{display:flex;gap:14px;flex-wrap:wrap;list-style:none;margin:0 0 10px;padding:0;font-size:13px;color:var(--suave)}
+.leyenda i{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:6px;vertical-align:-1px}
+.grafico{position:relative}
+.grafico svg{display:block;width:100%;height:auto;overflow:visible}
+.eje text{fill:var(--tenue);font-size:11px;font-family:var(--texto)}
+.eje line{stroke:var(--linea)}
+.punta{position:absolute;pointer-events:none;background:#fff;color:#0E1F3D;border-radius:10px;padding:8px 10px;font-size:13px;line-height:1.35;box-shadow:0 10px 30px rgba(0,0,0,.5);white-space:nowrap;transform:translate(-50%,calc(-100% - 10px));z-index:5}
+.punta b{display:block}
+.punta .f{display:flex;justify-content:space-between;gap:14px}
+.punta .f i{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:5px}
+.enlace{background:none;border:0;padding:0;color:var(--suave);text-decoration:underline;text-underline-offset:3px;font-size:13px}
+.tabla-graf{margin-top:10px}
+table{width:100%;border-collapse:collapse;font-size:14px}
+th{text-align:left;font-weight:500;color:var(--suave);font-size:13px;padding:8px 10px;border-bottom:1px solid var(--borde);white-space:nowrap}
+td{padding:9px 10px;border-bottom:1px solid var(--linea);vertical-align:middle}
+td.d,th.d{text-align:right;font-variant-numeric:tabular-nums}
+.desliza-x{overflow-x:auto}
+.zonas{display:grid;gap:9px}
+.zona{display:grid;grid-template-columns:minmax(120px,170px) 1fr 44px;gap:10px;align-items:center;font-size:13px}
+.zona .n{color:var(--suave);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.zona .pista{height:12px;background:rgba(255,255,255,.06);border-radius:0 4px 4px 0;overflow:hidden}
+.zona .pista i{display:block;height:100%;background:var(--pm);border-radius:0 4px 4px 0}
+.zona .v{text-align:right;font-variant-numeric:tabular-nums}
+.metodos{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:12px}
+.metodo .fila{display:flex;justify-content:space-between;font-size:14px;padding:5px 0;border-bottom:1px solid var(--linea)}
+.metodo .fila:last-child{border:0}
+.metodo h2{display:flex;align-items:center;gap:8px}
+.metodo h2 i{width:12px;height:12px;border-radius:3px;display:inline-block}
+.proporcion{display:flex;gap:2px;height:8px;margin:12px 0 10px}
+.proporcion span{display:block;height:100%}
+.proporcion span:first-child{border-radius:4px 0 0 4px}
+.proporcion span:last-child{border-radius:0 4px 4px 0}
+.estado{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:500;white-space:nowrap}
+.estado svg{width:14px;height:14px;flex:none}
+.herramientas{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:10px}
+.herramientas select,.herramientas input{width:auto;min-height:38px;background:var(--tarjeta);border:1px solid var(--borde);border-radius:9px;padding:6px 10px}
+.herramientas input{min-width:200px}
+.vacio{color:var(--suave);padding:18px 10px}
+.plan dl{display:grid;grid-template-columns:auto 1fr;gap:6px 16px;margin:0}
+.plan dt{color:var(--suave)}
+.plan dd{margin:0;font-weight:700;text-align:right}
+.nota{color:var(--tenue);font-size:12.5px;margin:10px 0 0}
+.pie{color:var(--tenue);font-size:13px;max-width:1320px;margin:0 auto;padding:0 24px 40px}
+@media (max-width:1100px){.tiles{grid-template-columns:repeat(2,1fr)}.tiles .tile:first-child{grid-column:span 2}.rejilla{grid-template-columns:1fr}.metodos{grid-template-columns:1fr}}
+@media (max-width:600px){main{padding:16px 12px 48px}.barra .dentro{padding:10px 12px}.tile .val{font-size:32px}.filtros select{min-width:0;width:100%}.herramientas input{min-width:0;flex:1}}
+@media (prefers-reduced-motion:reduce){*{transition:none!important}}
+</style>
