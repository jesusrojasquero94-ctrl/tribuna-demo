+}
+
+/* ---------- Eventos ---------- */
+var anchoPrevio = 0; window.addEventListener('resize', function(){ var w = $('grafVentas').clientWidth; if (S.ultima && Math.abs(w - anchoPrevio) > 40) { anchoPrevio = w; pintarVentas(S.ultima); } });
+var sel = $('elegirEstadio');
+sel.innerHTML = Object.keys(EST).map(function(k){ return '<option value="' + k + '">' + esc(EST[k].nombre) + ' (' + esc(EST[k].ciudad) + ')</option>'; }).join('');
